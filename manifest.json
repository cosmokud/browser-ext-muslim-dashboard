{
  "manifest_version": 3,
  "name": "Muslim Dashboard - Islamic New Tab",
  "short_name": "Muslim Dashboard",
  "version": "1.0.0",
  "description": "Transform your browser into customizable Islamic dashboard. Access a Pocket Quran, daily Quran and Hadith inspirations, and precise prayer times with Qibla direction. Stay organized with a Hijri calendar, fasting countdowns, and a built-in to-do list. Features include interactive flashcards, pinned apps, a custom search engine, and lunar phase tracking—all in one workspace.",
  "author": "Muslim Dashboard",
  "homepage_url": "https://github.com/browser-ext-muslim-dashboard",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": ["storage", "geolocation", "alarms", "notifications"],
  "host_permissions": [
    "https://api.quran.com/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://nominatim.openstreetmap.org/*",
    "https://www.google.com/s2/*",
    "https://*.gstatic.com/*"
  ],
  "background": {
    "service_worker": "js/service-worker.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Muslim Dashboard"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
