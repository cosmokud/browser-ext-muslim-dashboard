{
  "manifest_version": 3,
  "name": "Muslim Dashboard - Islamic New Tab",
  "short_name": "Muslim Dashboard",
  "version": "0.1.4",
  "description": "Transform your new tab into an Islamic dashboard! Features: Pocket Quran, Hadith collections, prayer/fasting times, flashcards, etc.",
  "author": "Muslim Dashboard",
  "homepage_url": "https://ko-fi.com/hikmahdigitalplatforms",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": ["storage", "geolocation", "alarms", "notifications", "tabs"],
  "host_permissions": [
    "https://api.quran.com/*",
    "https://download.quranicaudio.com/*",
    "https://verses.quran.com/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://nominatim.openstreetmap.org/*",
    "https://www.google.com/s2/*",
    "https://www.gstatic.com/*"
  ],
  "background": {
    "service_worker": "js/service-worker.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Muslim Dashboard",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
